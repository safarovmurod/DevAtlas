# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional one-time setup access, never included in the deployed/browser app.
# Bind securely to api.supabase.com to run scripts/setup-accounts.mjs.
REACT_MENTOR_SUPABASE_PROJECT_REF=
REACT_MENTOR_SITE_URL=
SUPABASE_ACCESS_TOKEN=

# Server-only secrets (Never expose to client/browser!)
SUPABASE_SERVICE_ROLE_KEY=
PAIRING_SECRET=

# Optional server-side course release. Leave blank to read local authoring files.
# Use the verified release SHA-256 reported by scripts/course-storage-release.mjs.
DEVATLAS_COURSE_RELEASE=

# Optional tutor. Server-only keys: never use NEXT_PUBLIC_ for them.
# Gemini is selected automatically when GEMINI_API_KEY is configured.
# Set AI_TUTOR_PROVIDER=anymodel to opt into the legacy provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_TUTOR_PROVIDER=gemini
# Optional: try Google Search grounding for online answers when course materials lack details.
AI_TUTOR_WEB_SEARCH=false

AI_TUTOR_ENABLED=false
AI_PROVIDER_KEY=
AI_MODEL=cx/gpt-6.1-sol

# Online AI fails closed unless these server-only durable budgets are configured.
# MICROUSD = millionths of USD; zero disables provider calls. Apply migration
# 20261026010000_tutor_budgets.sql and verify the model's billing/output bounds.
AI_DAILY_BUDGET_MICROUSD=0
AI_USER_DAILY_BUDGET_MICROUSD=0
AI_USER_DAILY_REQUEST_LIMIT=0
AI_MAX_MICROUSD_PER_TOKEN=0
AI_PROVIDER_USAGE_BOUND_CONFIRMED=false

# Optional real payments (Dodo Payments). Server-only secrets: set ALL five or none.
# Without them checkout answers billing_not_configured and nothing is charged.
# See docs/BILLING.md. DODO_PAYMENTS_ENVIRONMENT is test_mode or live_mode.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=
DODO_PRODUCT_PRO=
DODO_PRODUCT_ULTRA=
