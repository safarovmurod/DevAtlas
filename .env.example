# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional one-time setup access, never included in the deployed/browser app.
# Bind securely to api.supabase.com to run scripts/setup-accounts.mjs.
SUPABASE_ACCESS_TOKEN=

# Server-only secrets (Never expose to client/browser!)
SUPABASE_SERVICE_ROLE_KEY=
PAIRING_SECRET=

# Optional AnyModel tutor. Server-only key: never use NEXT_PUBLIC_ for it.
AI_TUTOR_ENABLED=false
AI_PROVIDER_KEY=
AI_MODEL=cx/gpt-6.1-sol

# Online AI fails closed unless these server-only durable budgets are configured.
# MICROUSD = millionths of USD; zero disables provider calls. Apply migration
# 20261026010000_tutor_budgets.sql and verify the model's billing/output bounds.
AI_DAILY_BUDGET_MICROUSD=0
AI_USER_DAILY_BUDGET_MICROUSD=0
AI_USER_DAILY_REQUEST_LIMIT=0
AI_MAX_MICROUSD_PER_TOKEN=0
AI_PROVIDER_USAGE_BOUND_CONFIRMED=false
